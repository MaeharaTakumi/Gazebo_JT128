<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jt128_description</name>
  <version>0.1.0</version>
  <description>Gazebo Sim 用 Hesai JT128 3D LiDAR の URDF/xacro 記述パッケージ</description>
  <maintainer email="user@example.com">student</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- ros_gz_sim の gz_sim.launch.py が GZ_SIM_RESOURCE_PATH へ自動追加する設定 -->
    <gazebo_ros gazebo_model_path="${prefix}/../"/>
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
  </export>
</package>
